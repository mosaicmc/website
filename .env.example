# Mosaic Website — environment variables
#
# Only the two HubSpot values below are actually required. Everything under
# "Legacy / inactive" is referenced by old code paths that are guarded, so the
# app runs fine when they are empty. Do NOT commit real values (.env.local is
# git-ignored); set production values in Vercel → Settings → Environment Variables.

# --- Required (production) ---
# HubSpot portal + form IDs — power the gated PDF-download forms
# (src/app/api/download-gate-log, src/app/api/volunteer-pd-download).
# These are identifiers, not secret credentials.
HUBSPOT_PORTAL_ID=your_hubspot_portal_id
HUBSPOT_FORM_ID=your_hubspot_form_id

# --- Optional ---
# Feature flag: shows the Stories/News page and its nav links. Defaults to off.
NEXT_PUBLIC_FEATURE_STORIES_PAGE=false
# Asset base-path prefix. Leave empty for a root-hosted deployment.
NEXT_PUBLIC_BASE_PATH=

# --- Legacy / inactive (kept only so old API routes don't crash; leave empty) ---
# Employment Hero ATS — REPLACED by direct SEEK links; no longer used.
EH_ORG_ID=
EH_ATS_TOKEN=
# Stripe server key — no active server-side Stripe integration.
STRIPE_SECRET_KEY=
# Google Sheets webhook — form/download logging now goes through HubSpot.
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Removed ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY / NEXT_PUBLIC_GOOGLE_PLACE_ID were declared
# but are not referenced anywhere in the code. Safe to ignore/remove.
