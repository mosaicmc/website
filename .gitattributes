# Treat binary assets as binary so they are never normalized/re-encoded as text.
# (A past UTF-8 text conversion corrupted these files; this prevents recurrence.)
*.pdf   binary
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.avif  binary
*.mp4   binary
*.webm  binary
*.mov   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
